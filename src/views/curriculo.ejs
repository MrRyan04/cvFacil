<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title><%= curriculo.titulo %></title>

    <link rel="stylesheet" href="/css/curriculo.css">
</head>
<body>

    <div class="cv">

        <!-- HEADER -->
        <header class="cv-header">

            <h1><%= curriculo.nome %></h1>

            <div class="cv-contact">
                <span><%= curriculo.email %></span>
                <span>•</span>
                <span><%= curriculo.telefone %></span>
                <span>•</span>
                <span><%= curriculo.cidade %></span>
            </div>

        </header>

        <hr>

        <!-- SEÇÕES -->
        <section>
            <h2>Objetivo</h2>
            <p><%= curriculo.objetivo %></p>
        </section>

        <section>
            <h2>Sobre</h2>
            <p><%= curriculo.sobre %></p>
        </section>

        <section>
            <h2>Formação</h2>
            <p><%= curriculo.formacao %></p>
        </section>

        <section>
            <h2>Experiência</h2>
            <p><%= curriculo.experiencia %></p>
        </section>

    </div>

</body>
</html>